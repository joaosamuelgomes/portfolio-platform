# Caddy gets and renews the Let's Encrypt certificate for API_DOMAIN on its own.
{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Also bounds the one public POST (/auth/token); the largest article is far below this.
	request_body {
		max_size 1MB
	}

	reverse_proxy api:8080
}
