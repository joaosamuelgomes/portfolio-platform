# Copie para .env (que não é versionado) e preencha. Usado pelo docker compose.

# Chave HS256 dos tokens, 32+ caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=

# Conta que escreve conteúdo. Sem senha, a conta fica desativada.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Conta demo, só leitura, para recrutadores. Sem senha, a conta fica desativada.
VIEWER_USERNAME=recrutador
VIEWER_PASSWORD=

DATABASE_PASSWORD=portfolio
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Deploy Hook do Vercel (Settings > Git > Deploy Hooks). Segredo; vazio desativa "Atualizar site".
SITE_DEPLOY_HOOK_URL=
